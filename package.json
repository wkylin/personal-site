{
  "name": "wkylin-personal-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/index.js",
    "server:dev": "NODE_ENV=development node server/index.js",
    "server:prod": "NODE_ENV=production node server/index.js",
    "dev:server": "concurrently \"NODE_ENV=development nodemon server/index.js\" \"pnpm dev\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "express": "^5.2.1",
    "lenis": "^1.3.23",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.15.3",
    "nodemon": "^3.1.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-icons": "^16.21.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.3.5",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "concurrently": "^10.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
